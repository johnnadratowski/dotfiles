# Canonical PATH ordering lives in scripts/env-vars.sh.
export PATH=/opt/homebrew/bin:$PATH:/usr/local/bin

# Path to your oh-my-zsh configuration.
ZSH=$HOME/.oh-my-zsh

# Set name of the theme to load.
# Look in ~/.oh-my-zsh/themes/
# Optionally, if you set this to "random", it'll load a random theme each
# time that oh-my-zsh is loaded.
#ZSH_THEME="mine"
#ZSH_THEME="unified"
#ZSH_THEME="candy"
#ZSH_THEME="unicandy"
ZSH_THEME="agkozak"
AGKOZAK_PROMPT_CHAR=( '[%F{yellow}%*%f] %F{magenta}❯%f' '[%F{yellow}%*%f] %F{magenta}❯%f' '[%F{yellow}%*%f] %F{green}❮%f' )
AGKOZAK_CUSTOM_SYMBOLS=( '⇣⇡' '⇣' '⇡' '+' 'x' '!' '>' '?' 'S')
AGKOZAK_PROMPT_DIRTRIM=4 
AGKOZAK_BLANK_LINES=1
AGKOZAK_LEFT_PROMPT_ONLY=1

if [[ ! "$SSH_CLIENT" == "" || ! "$SSH_TTY" == "" ]]; then
  AGKOZAK_PROMPT_CHAR=( '[%F{yellow}%*%f] 🌐  %F{magenta}❯%f' '[%F{yellow}%*%f] 🌐  %F{magenta}❯%f' '[%F{yellow}%*%f] 🌐  %F{green}❮%f' )
fi

# Set to this to use case-sensitive completion
# CASE_SENSITIVE="true"

# Comment this out to disable bi-weekly auto-update checks
DISABLE_AUTO_UPDATE="true"

# Uncomment to change how many often would you like to wait before auto-updates occur? (in days)
# export UPDATE_ZSH_DAYS=13

# Uncomment following line if you want to disable colors in ls
# DISABLE_LS_COLORS="true"

# Uncomment following line if you want to disable autosetting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment following line if you want red dots to be displayed while waiting for completion
COMPLETION_WAITING_DOTS="true"

# Which plugins would you like to load? (plugins can be found in ~/.oh-my-zsh/plugins/*)
# Custom plugins may be added to ~/.oh-my-zsh/custom/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
plugins=(aws direnv history-substring-search dirhistory docker git git-extras jsontools mvn node npm pep8 pip python pylint redis-cli tmux urltools vagrant web-search wd zsh-vim-mode yarn fzf)
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window down:3:wrap --bind '?:toggle-preview'"

# AUTOLOADS
autoload zmv

setopt HIST_IGNORE_ALL_DUPS
bindkey -M emacs '^P' history-substring-search-up
bindkey -M emacs '^N' history-substring-search-down

# Setup custom plugin location
fpath=(~/scripts/zsh/plugins $fpath)

export ZSH_CUSTOM=$HOME/git/dotfiles/zsh_custom

source $ZSH/oh-my-zsh.sh

# Begin loading my stuff

. ~/.shellrc

if [ -f aws_zsh_completer.sh ]
then
    source aws_zsh_completer.sh
fi

# Make Vi mode transitions faster (KEYTIMEOUT is in hundredths of a second)
export KEYTIMEOUT=1
MODE_CURSOR_VIINS="#00ff00 blinking bar"
MODE_CURSOR_REPLACE="$MODE_CURSOR_VIINS #ff0000"
MODE_CURSOR_VICMD="green block"
MODE_CURSOR_SEARCH="#ff00ff steady underline"
MODE_CURSOR_VISUAL="$MODE_CURSOR_VICMD steady bar"
MODE_CURSOR_VLINE="$MODE_CURSOR_VISUAL #00ffff"

PROC_TRANS=$(sysctl -n sysctl.proc_translated &> /dev/null || return 0)
if [[ $OSTYPE == 'darwin'* ]]; then
  if [[ $(arch) == 'i386' && "$PROC_TRANS" == "1" ]]; then
    export TMUX=notmux
  fi
fi

# Auto-attach a fresh terminal to tmux.
#
# THE SESSION NAME IS A VARIABLE, not a constant. It used to be a hardcoded `main`, which
# meant every iTerm window you opened attached to the SAME session: the second window
# mirrored the first, both fought over which tmux window was active, and the size of both
# was clamped to the smaller terminal. That is one session viewed twice, not two workspaces.
#
# Set TMUX_SESSION in an iTerm profile (Profiles -> General -> Send text at start, or an
# environment variable) to give that profile its own workspace — e.g. a `goals-b` profile on
# the second monitor running a separate fleet. Unset, the behaviour is exactly as before.
#
# `-A` still means attach-if-exists, so reopening a window rejoins its own session rather
# than piling up duplicates.
if [[ "$TMUX" = "" && "$SSH_CLIENT" == "" && "$SSH_TTY" == "" ]]; then
	if command -v tmux &>/dev/null; then
		exec tmux -2 new-session -A -s "${TMUX_SESSION:-main}"
	fi
fi

# tm [name] — jump to a tmux session by name, creating it if absent. From outside tmux it
# attaches; from inside it switches the current client, which is the case a bare
# `tmux attach` refuses. No argument lists what exists.
#
# NOT `t`: scripts/aliases.sh already owns that for `tree -L 1`, and `ta` is built on it.
# zsh alias-expands the name in a function definition, so `t() {` parsed as
# `tree -L 1 () {` and killed the rest of the file.
tm() {
	if [[ -z "$1" ]]; then
		tmux list-sessions -F '#{session_name}: #{session_windows} windows#{?session_attached, (attached),}' 2>/dev/null ||
			echo "no tmux server running"
		return 0
	fi
	tmux has-session -t "$1" 2>/dev/null || tmux new-session -d -s "$1"
	if [[ -n "$TMUX" ]]; then tmux switch-client -t "$1"; else tmux attach -t "$1"; fi
}

# Machine-local fleet layout (~/.claude/fleet.env — not in this repo; it names one product's
# checkout on one machine). Exported here so a `claude` launched from an interactive shell
# carries it, and re-read from the file by every fleet script and by the lane-guard hook, whose
# environment is frozen at its claude's launch. Absent on a machine with no fleet: harmless.
if [ -r ~/.claude/fleet.env ]; then
	source ~/.claude/fleet.env
	export WORKFLOW_LANES_DIR
fi

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# bun completions (BUN_INSTALL set in env-vars.sh; nvm loaded via init.sh)
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
