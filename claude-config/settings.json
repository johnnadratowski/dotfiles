{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint)",
      "Bash(npx eslint:*)",
      "Bash(forge test:*)",
      "Bash(npm run sync:*)",
      "Bash(make:*)",
      "Bash(cat:*)",
      "Bash(npx next build:*)",
      "Bash(npm run build:*)",
      "Bash(npm install:*)",
      "Bash(npm run tsc:*)",
      "Bash(find:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(xargs ls:*)",
      "Bash(yarn tsc:*)",
      "Bash(npm uninstall:*)",
      "Bash(grep:*)",
      "Bash(git checkout:*)",
      "Bash(*agent-fanout.sh:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "EnterWorktree",
      "Bash(open:*)",
      "Bash(xdg-open:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "unblock": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git -C \"${CLAUDE_PROJECT_DIR:-$PWD}\" rev-parse --show-toplevel 2>/dev/null) || exit 0; [ -f \"$r/.claude/workflow.config\" ] || exit 0; h=\"$HOME/.claude/hooks/register-agent.sh\"; [ -x \"$h\" ] || h=\"$r/.claude/hooks/register-agent.sh\"; [ -x \"$h\" ] || exit 0; exec bash \"$h\" sessionstart'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/monocle.sh\" hooks exit-plan --agent claude",
            "timeout": 3600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/monocle.sh\" hooks mark-activity --agent claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/mark-busy.sh\""
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/monocle.sh\" hooks enter-plan --agent claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/unregister-agent.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/mark-busy.sh\" clear"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/monocle.sh\" hooks on-stop --agent claude",
            "timeout": 3600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/mark-busy.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/place-subagents.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 30
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/scripts/subagent-statusline.sh\""
  },
  "enabledPlugins": {
    "claude-notifications-go@claude-notifications-go": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "low",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
